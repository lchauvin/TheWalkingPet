# ---------------------------------------------------------------------------
# Copy to .env for local development, or .env.prod for a deployment.
# Every value below is a development default — none is safe in production.
# ---------------------------------------------------------------------------

# local | staging | production
# In production the app refuses to start while any example credential is in use.
ENVIRONMENT=local

# Database
POSTGRES_USER=twp
POSTGRES_PASSWORD=twp_secret
POSTGRES_DB=thewalkingpet
POSTGRES_HOST=localhost
POSTGRES_PORT=9876

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth policy
PASSWORD_MIN_LENGTH=10

# Rate limiting. Leave the storage URI empty for per-process counters; point it
# at Redis to share limits across workers (required if WEB_CONCURRENCY > 1).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_WRITE=60/minute

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Firebase service account. This path is only used for host-side runs: both
# Compose stacks mount the key at /run/secrets/firebase_credentials and set
# FIREBASE_CREDENTIALS_PATH themselves, overriding whatever is set here.
# Point FIREBASE_CREDENTIALS_FILE at the key if it is not at the repo root.
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Storage
STORAGE_PATH=./storage/images
MAX_UPLOAD_MB=12

# ML. EMBEDDING_DIM must match the vector(N) columns in the database and the
# embedder's output — DINOv2 ViT-L/14 produces 1024. Changing it requires a
# migration plus scripts/reembed_all.py.
YOLO_MODEL=yolov8m-seg.pt
EMBEDDING_DIM=1024
MODEL_TYPE=dinov2

# Matching: no declaration may search wider than the candidate bounding box.
MAX_SEARCH_RADIUS_KM=10

# HTTP. Comma-separated browser origins; leave empty for a mobile-only client.
CORS_ORIGINS=

# Background jobs. Exactly one process in the deployment may set this true.
# The production stack runs scripts/run_scheduler.py instead and sets it false.
RUN_SCHEDULER=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# App
DEBUG=false

# --- Production stack only (docker-compose.prod.yml) ---
# DOMAIN=pets.example.com
# ACME_EMAIL=you@example.com
# WEB_CONCURRENCY=2
